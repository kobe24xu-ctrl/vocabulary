{
  "name": "lexiclass",
  "version": "1.0.0",
  "private": true,
  "description": "Foundation programme classroom vocabulary and contextual dictation",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:browser": "node test/browser.mjs",
    "demo:build": "node scripts/build-demo.mjs",
    "test:demo": "node test/demo-browser.mjs",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local --config cloudflare/wrangler.jsonc",
    "cf:deploy": "python3 scripts/deploy-cloudflare.py"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.151.1"
  }
}
